datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String       @id @default(uuid())
  userlogin    String       @unique // Username จาก BRU SSO
  fullName     String
  email        String?
  role         String       @default("AUDITOR") // ADMIN, AUDITOR, SUPERVISOR, HOUSEKEEPER
  departmentId String?
  positionName String?
  phone        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  assessments  Assessment[] @relation("AssessorAssessments")
  assignedBuildings BuildingStaff[]
}

model EvaluationRound {
  id          String   @id @default(uuid())
  name        String
  year        String
  description String?
  startDate   String
  endDate     String
  status      String   @default("OPEN") // 'OPEN' | 'CLOSED'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Building {
  id          String       @id @default(uuid())
  code        String       @unique // รหัสอาคาร เช่น B15, B22
  name        String       // ชื่ออาคาร เช่น อาคาร 15 เฉลิมพระเกียรติ
  floors      Int?         @default(1)
  description String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  staffs      BuildingStaff[]
  assessments Assessment[]
}

model BuildingStaff {
  id          String   @id @default(uuid())
  buildingId  String
  userId      String?
  staffName   String   // ชื่อ-สกุลแม่บ้าน/ผู้รับผิดชอบประจำอาคาร
  phone       String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())

  building    Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Category {
  id          Int      @id // 1 ถึง 7
  name        String   // หมวดที่ 1 ถึง 7
  order       Int
  items       QuestionItem[]
}

model QuestionItem {
  id          Int      @id // 1 ถึง 35
  categoryId  Int
  itemNumber  Int
  title       String
  maxScore    Int      @default(5)

  category    Category @relation(fields: [categoryId], references: [id])
  scores      ScoreItem[]
}

model Assessment {
  id                    String          @id @default(uuid())
  roundId               String?         @default("round-2570")
  buildingId            String
  staffId               String?         // ID ผู้ปฏิบัติงานรายบุคคลที่ถูกประเมิน (กรณีเลือกจากฐานข้อมูล)
  assessorId            String
  responsibleStaffText  String          // รายชื่อผู้รับผิดชอบ ณ วันที่ประเมิน
  assessedAt            DateTime        @default(now())
  
  // ผลการคำนวณคะแนน
  totalScoreObtained    Float
  totalMaxScore         Float
  percentage            Float
  grade                 String          // EXCELLENT, GOOD, FAIR, IMPROVEMENT, URGENT_ACTION

  // ตอนที่ 2: ข้อค้นพบจากการตรวจ
  strengthsSummary      String?         // จุดเด่นในการปฏิบัติงาน
  urgentProblems        String?         // จุดที่ต้องปรับปรุงเร่งด่วน
  correctivePlan        String?         // แนวทางแก้ไขและกำหนดเวลา
  targetDeadline        DateTime?       // วันที่ครบกำหนดแก้ไข
  followUpResult        String?         // ผลการตรวจติดตามหลังการปรับปรุง
  isFollowedUp          Boolean         @default(false)
  followedUpAt          DateTime?

  // ลายเซ็นดิจิทัล
  signatureImage        String?         // Data URL หรือ File Path ลายเซ็น

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  building              Building        @relation(fields: [buildingId], references: [id])
  assessor              User            @relation("AssessorAssessments", fields: [assessorId], references: [id])
  scores                ScoreItem[]
  attachments           FindingAttachment[]
}

model ScoreItem {
  id             String       @id @default(uuid())
  assessmentId   String
  questionItemId Int
  score          Int?         // 1-5 หรือ null เมื่อเลือก N/A
  isNA           Boolean      @default(false)
  defectNote     String?      // ข้อบกพร่องที่พบ
  photoUrl       String?      // รูปภาพหลักฐานข้อบกพร่อง

  assessment     Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionItem   QuestionItem @relation(fields: [questionItemId], references: [id])

  @@unique([assessmentId, questionItemId])
}

model FindingAttachment {
  id           String     @id @default(uuid())
  assessmentId String
  type         String     // 'STRENGTH', 'URGENT_DEFECT', 'FOLLOW_UP'
  fileUrl      String
  caption      String?
  createdAt    DateTime   @default(now())

  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
}

model SystemSetting {
  key       String   @id
  value     String   // JSON string configuration
  updatedAt DateTime @updatedAt
}
